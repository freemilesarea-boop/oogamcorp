# ─────────────────────────────────────────────────────────────
# OOGAM 환경 설정 예시. 복사 후 값 변경: cp .env.example .env
# 실제 비밀값은 절대 커밋하지 마십시오.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development            # development | test | staging | production

# Web (Next.js)
WEB_PORT=3000
PUBLIC_SITE_URL=http://localhost:3000          # 운영: https://oogam.co.kr
API_INTERNAL_URL=http://localhost:4000          # Next 서버 → API 내부 호출 주소 (docker: http://api:4000)
NEXT_PUBLIC_COLLAB_URL=ws://localhost:4001      # 운영: wss://oogam.co.kr/collab

# API (NestJS)
API_PORT=4000
COLLAB_PORT=4001
WEB_ORIGINS=http://localhost:3000               # 콤마 구분, 운영: https://oogam.co.kr
SWAGGER_ENABLED=true                            # 운영 기본 false
LOG_LEVEL=debug

# Database / Redis
POSTGRES_USER=oogam
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=oogam
DATABASE_URL=postgresql://oogam:change-me-strong-password@localhost:5432/oogam?schema=public
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@localhost:6379

# Session / Security
COOKIE_SECURE=false                             # 운영(HTTPS) 반드시 true
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
IP_HASH_SALT=change-me-random-string            # 문의 접수 IP 해시용 (openssl rand -hex 32)

# Object storage (S3 호환: AWS S3, MinIO, Cloudflare R2, NCP Object Storage 등)
STORAGE_DRIVER=local                            # local | s3
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=ap-northeast-2
S3_BUCKET=oogam
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=25

# SMTP (설정 전까지 이메일 알림 비활성)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OOGAM <no-reply@oogam.co.kr>"

# Seed (최초 1회)
SEED_OWNER_EMAIL=owner@oogam.co.kr
SEED_OWNER_NAME=최고관리자
SEED_OWNER_PASSWORD=                            # 비워두면 개발 환경에서 임시 비밀번호를 생성해 1회 출력
