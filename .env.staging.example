# 스테이징 환경 예시 (실제 고객·직원 데이터 사용 금지 — 가상 데이터만)
NODE_ENV=staging
PUBLIC_SITE_URL=http://localhost:8080
WEB_ORIGINS=http://localhost:8080
NEXT_PUBLIC_COLLAB_URL=ws://localhost:8080/collab
COOKIE_SECURE=false                 # 스테이징을 HTTPS 로 운영하면 true
POSTGRES_USER=oogam
POSTGRES_PASSWORD=change-me-staging-db
POSTGRES_DB=oogam_staging
REDIS_PASSWORD=change-me-staging-redis
IP_HASH_SALT=change-me-openssl-rand-hex-32
APP_ENCRYPTION_KEY=change-me-openssl-rand-base64-32
MFA_REQUIRED_ROLES=OWNER,EXECUTIVE
MALWARE_SCAN_MODE=required
STORAGE_DRIVER=local
SWAGGER_ENABLED=false
SMTP_ENABLED=false
SEED_OWNER_EMAIL=owner@staging.oogam.invalid
SEED_OWNER_PASSWORD=change-me-staging-owner
